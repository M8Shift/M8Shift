#!/bin/sh
# M8Shift pre-push scrub gate (RFC 052 E2) — the last safe moment before content
# leaves the machine.
#
# ADVISORY and LOCAL by default: findings are printed, the push proceeds. Set
# M8SHIFT_SCRUB_ENFORCE=1 to BLOCK the push on findings. Scrub scanner ERRORS
# fail closed: inability to inspect publish-bound objects is not a clean result.
# `git push --no-verify` bypasses this hook entirely, by design (git semantics).
#
# What runs:
#   1. `m8shift.py doctor --hygiene-only --lint` — the RFC 052 C1+C3 data-hygiene
#      lint (real home paths + operator-confidential denylist, redacted output).
#   2. `checksums.sha256` (if present) — verifies that shipped artifacts still
#      match the release manifest. Mismatches follow the same advisory/enforce
#      policy as scrub findings; verifier errors fail open.
#   3. `scripts/scrub-check.py` (if present) — the denylist over WHAT THIS PUSH
#      PUBLISHES: git feeds the hook one `<local ref> <local sha> <remote ref>
#      <remote sha>` line per ref on stdin, and each becomes a `--range`
#      (remote..local; a bare local sha when the remote side is new or unknown;
#      deletions are skipped — nothing leaves). Bare-sha history exclusions are
#      limited to tracking refs of the TARGET remote, and annotated tag messages
#      are read from their tag objects. Raw git, never a lossy optimizer.
#      Scanning only the pushed ranges keeps the hook fast and prevents local
#      side refs/reflogs/unreachable objects from blocking clean publication.
#      The full walk remains explicit (CI, audits): run scrub-check.py --all.
#      rc 1 = hit, rc >= 2 = scanner error (fail closed).
#
# Install (per clone, hooks are not version-controlled by Git):
#   git config core.hooksPath hooks
#   (or: cp hooks/pre-push <repo>/.git/hooks/pre-push && chmod +x it)

set -eu

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || printf '.')"

# Git supplies the target remote name (or URL) as argv[1]. Only pass a configured
# name to scrub-check; URL pushes have no trustworthy remote-tracking namespace
# and therefore conservatively exclude nothing.
target_remote=""
if [ "${#}" -ge 1 ] && git remote get-url -- "${1}" >/dev/null 2>&1; then
	target_remote="${1}"
fi

# Resolve the m8shift.py program (soft: everything here is advisory-by-default).
m8shift=""
if [ -n "${M8SHIFT_BIN:-}" ] && [ -x "${M8SHIFT_BIN}" ]; then
	m8shift="${M8SHIFT_BIN}"
elif command -v m8shift.py >/dev/null 2>&1; then
	m8shift="m8shift.py"
elif [ -x "${repo_root}/m8shift.py" ]; then
	m8shift="${repo_root}/m8shift.py"
fi

block=0

# --- 1. data-hygiene lint (C1 paths + C3 denylist, redacted) ---------------------
if [ -n "${m8shift}" ]; then
	hygiene_rc=0
	"${m8shift}" doctor --hygiene-only --lint >&2 || hygiene_rc=$?
	if [ "${hygiene_rc}" -eq 1 ]; then
		block=1
	elif [ "${hygiene_rc}" -gt 1 ]; then
		printf '%s\n' "m8shift pre-push: hygiene scanner failed (rc ${hygiene_rc}) — continuing without it." >&2
	fi
fi

# --- 2. release checksum manifest ------------------------------------------------
manifest="${repo_root}/checksums.sha256"
if [ -f "${manifest}" ]; then
	checksum_rc=0
	if command -v sha256sum >/dev/null 2>&1; then
		(cd "${repo_root}" && sha256sum -c checksums.sha256) >&2 || checksum_rc=$?
	elif command -v shasum >/dev/null 2>&1; then
		(cd "${repo_root}" && shasum -a 256 -c checksums.sha256) >&2 || checksum_rc=$?
	else
		checksum_rc=2
	fi
	if [ "${checksum_rc}" -eq 1 ]; then
		printf '%s\n' "m8shift pre-push: checksums.sha256 is stale or invalid." >&2
		block=1
	elif [ "${checksum_rc}" -gt 1 ]; then
		printf '%s\n' "m8shift pre-push: checksum verification failed (rc ${checksum_rc}) — continuing without it." >&2
	fi
fi

# --- 3. denylist scrub over the pushed ranges (E1) --------------------------------
# Git's pre-push stdin: one `<local ref> <local sha> <remote ref> <remote sha>`
# line per ref being pushed. Only read it when stdin is NOT a terminal (a manual
# `sh hooks/pre-push` run from a shell has no ref lines — fall back to the
# direct HEAD scan rather than hang on a read).
ranges=""
# Initialised beside `ranges`, OUTSIDE the stdin guard. It was declared inside it,
# and expanded unconditionally further down under `set -eu`, so the documented
# manual-run path — `sh hooks/pre-push` from a shell, where stdin IS a terminal —
# aborted with `bases: unbound variable` before the scan ran at all. A real push was
# unaffected because git always supplies a pipe, so the breakage was fail-closed;
# what it cost was the operator's hand-run pre-flight, and a hook that errors is a
# hook someone reaches past with --no-verify.
bases=""
stdin_lines=0
new_refs=0
if [ ! -t 0 ]; then
	while read -r _local_ref local_sha remote_ref remote_sha; do
		[ -n "${local_sha:-}" ] || continue
		stdin_lines=$((stdin_lines + 1))
		case "${local_sha}" in
		*[!0]*) ;;                       # has a non-zero digit: a real object
		*) continue ;;                   # all zeros: a DELETION — nothing leaves
		esac
		case "${remote_sha:-}" in
		"" ) ranges="${ranges} --range ${local_sha} --ref ${remote_ref}" ;;
		*[!0]*)
			# Known remote base -> scan exactly the new commits. If the base
			# object is absent locally (stale tracking), the bare-sha form
			# over-scans relative to target-remote tracking instead of erroring.
			if git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
				ranges="${ranges} --range ${remote_sha}..${local_sha} --ref ${remote_ref}"
				# #262: git proved the destination has this commit. It is the
				# only endpoint-authoritative evidence a client-side hook gets,
				# and it lets a finding on ANOTHER ref of this same batch be
				# reported as pre-existing instead of blocking. A local branch
				# reaching the commit proves nothing and is never used for this.
				bases="${bases} --endpoint-base ${remote_sha}"
			else
				ranges="${ranges} --range ${local_sha} --ref ${remote_ref}"
			fi
			;;
		*)
			# NEW ref (#300). Git supplies no remote_sha here, so #262 has no
			# endpoint evidence and the bare-sha form scans all reachable
			# history and can downgrade nothing. That is correct and it is also
			# why a repository whose PUBLISHED history carries a denied term
			# cannot create a tag or branch at all.
			#
			# An operator may attest the published base beforehand. The helper
			# re-observes the real push endpoint here, and only a live match
			# yields a base; every refusal falls through to the bare-sha scan
			# below, which blocks exactly as before. This is not a bypass: the
			# tag object, the pushed tip, paths, messages and every commit after
			# the base stay scanned. V1 attests ONE non-deletion ref per push.
			attested=""
			if [ -n "${M8SHIFT_PUBLISH_ATTESTATION:-}" ] && [ "${new_refs}" -eq 0 ]; then
				attest="${repo_root}/scripts/publish-attest.py"
				if [ -f "${attest}" ]; then
					attested="$(python3 "${attest}" --repo "${repo_root}" consume \
						--receipt-id "${M8SHIFT_PUBLISH_ATTESTATION}" \
						--source-sha "${local_sha}" \
						--destination-ref "${remote_ref}" 2>&1 | tail -1)"
					case "${attested}" in
					*[!0-9a-f]*|"") attested="" ;;   # any refusal text is not a sha
					esac
				fi
			fi
			new_refs=$((new_refs + 1))
			if [ -n "${attested}" ]; then
				ranges="${ranges} --range ${attested}..${local_sha} --ref ${remote_ref}"
				bases="${bases} --endpoint-base ${attested}"
				printf '%s\n' "m8shift pre-push: published-base attestation consumed for ${remote_ref}; scanning from the attested base." >&2
			else
				ranges="${ranges} --range ${local_sha} --ref ${remote_ref}"
			fi
			;;
		esac
	done
fi

scrub="${repo_root}/scripts/scrub-check.py"
if [ -f "${scrub}" ]; then
	if [ "${stdin_lines}" -gt 0 ] && [ -z "${ranges}" ]; then
		# Every pushed ref was a deletion: nothing new leaves the machine.
		printf '%s\n' "m8shift pre-push: deletion-only push — scrub skipped (nothing published)." >&2
	else
		scrub_rc=0
		run_scrub() {
			python3 -c '
import runpy
import sys
try:
    scanner = sys.argv[1]
    sys.argv = sys.argv[1:]
    runpy.run_path(scanner, run_name="__main__")
except SystemExit as exc:
    if isinstance(exc.code, int):
        sys.exit(exc.code)
    print("scrub-check: ERROR invalid scanner exit", file=sys.stderr)
    sys.exit(2)
except BaseException as exc:
    print("scrub-check: ERROR scanner could not start (%s)" %
          exc.__class__.__name__, file=sys.stderr)
    sys.exit(2)
' "${scrub}" "$@"
		}
		# shellcheck disable=SC2086 # intentional word-splitting: hex-only rev specs
		if [ -n "${target_remote}" ]; then
			run_scrub --repo "${repo_root}" --remote "${target_remote}" ${bases} ${ranges} >&2 || scrub_rc=$?
		else
			run_scrub --repo "${repo_root}" ${ranges} >&2 || scrub_rc=$?
		fi
		if [ "${scrub_rc}" -eq 1 ]; then
			block=1
		elif [ "${scrub_rc}" -ge 2 ]; then
			printf '%s\n' "m8shift pre-push: scrub-check failed (rc ${scrub_rc}) — push blocked (scan errors fail closed)." >&2
			exit 1
		fi
	fi
fi

if [ "${block}" -eq 1 ]; then
	if [ "${M8SHIFT_SCRUB_ENFORCE:-0}" = "1" ]; then
		printf '%s\n' "m8shift pre-push: gate findings above and M8SHIFT_SCRUB_ENFORCE=1 — push blocked. Fix the findings or unset the enforce variable." >&2
		exit 1
	fi
	printf '%s\n' "m8shift pre-push: gate findings above are ADVISORY (set M8SHIFT_SCRUB_ENFORCE=1 to block on them); pushing anyway." >&2
fi

exit 0
